{
  "name": "@maciejtrzcinski/sanity-plugin-schema-visualization",
  "version": "1.0.0",
  "description": "Sanity Studio tool that visualizes your schema as an interactive canvas of types, fields, options and reference connections",
  "keywords": [
    "canvas",
    "graph",
    "sanity",
    "sanity-plugin",
    "schema",
    "visualization"
  ],
  "homepage": "https://github.com/maciejtrzcinski/sanity-plugin-schema-visualization#readme",
  "bugs": {
    "url": "https://github.com/maciejtrzcinski/sanity-plugin-schema-visualization/issues"
  },
  "license": "MIT",
  "author": "Maciej Trzcinski <maciej.jacek.trzcinski@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maciejtrzcinski/sanity-plugin-schema-visualization.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./registry": {
      "source": "./src/exports/registry.ts",
      "default": "./dist/registry.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.js",
      "./registry": "./dist/registry.js",
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "scripts": {
    "build": "plugin-kit verify-package --silent && pkg-utils build --strict --check --clean",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run format:check && pnpm run knip && pnpm run test",
    "dev": "cd dev && sanity dev",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "knip": "knip",
    "link-watch": "plugin-kit link-watch",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "prepublishOnly": "pnpm run build",
    "size": "size-limit",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p dev",
    "watch": "pkg-utils watch --strict"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.3",
    "@sanity/icons": "^5.2.3",
    "@sanity/ui": "^4.4.10",
    "@xyflow/react": "^12.12.0"
  },
  "devDependencies": {
    "@sanity/browserslist-config": "^1.0.5",
    "@sanity/pkg-utils": "^13.0.16",
    "@sanity/plugin-kit": "^10.1.0",
    "@sanity/semantic-release-preset": "^6.0.0",
    "@size-limit/esbuild": "^14.3.0",
    "@size-limit/file": "^14.3.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.3.0",
    "jsdom": "^30.1.3",
    "knip": "^6.43.0",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2005",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sanity": "^6.20.0",
    "semantic-release": "^25.0.9",
    "size-limit": "^14.3.0",
    "styled-components": "^6.6.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "peerDependencies": {
    "react": "^19.2",
    "react-dom": "^19.2",
    "sanity": "^5 || ^6.0.0-0",
    "styled-components": "^6.1"
  },
  "browserslist": "extends @sanity/browserslist-config",
  "engines": {
    "node": ">=20.19 <22 || >=22.12"
  },
  "packageManager": "pnpm@10.4.1",
  "sanityPlugin": {
    "verifyPackage": {
      "tsconfig": false
    }
  }
}
