# Copy to `dev/.env` (gitignored). The Sanity CLI loads it for both
# `sanity.cli.ts` and the Studio; a variable set in the shell still wins.

# The graph reads the schema, so the placeholder project is enough to browse
# it. A real project turns on what calls the API, document counts mainly.
SANITY_STUDIO_PROJECT_ID=your-project-id
SANITY_STUDIO_DATASET=production

# 1 swaps in the synthetic 331-type schema the layout benchmarks run against.
SANITY_STUDIO_LARGE_SCHEMA=
